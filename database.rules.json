{
  "rules": {
    ".read": false,
    ".write": false,
    "v2": {
      "feedback": {
        "$code": {
          ".read": "auth != null && root.child('v2/games').child($code).child('control/teacherUid').val() === auth.uid"
        }
      },
      "games": {
        "$code": {
          "publicJson": {
            ".read": "auth != null && (root.child('v2/games').child($code).child('control/teacherUid').val() === auth.uid || root.child('v2/games').child($code).child('control/members').child(auth.uid).child('joined').val() === true)"
          },
          "groups": {
            ".read": "auth != null && root.child('v2/games').child($code).child('control/teacherUid').val() === auth.uid",
            "$group": {
              ".read": "auth != null && root.child('v2/games').child($code).child('control/members').child(auth.uid).child('groupId').val() === $group"
            }
          },
          "private": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid && root.child('v2/games').child($code).child('control/members').child(auth.uid).child('joined').val() === true"
            }
          }
        }
      },
      "presence": {
        "$code": {
          ".read": "auth != null && (root.child('v2/games').child($code).child('control/teacherUid').val() === auth.uid || root.child('v2/games').child($code).child('control/members').child(auth.uid).child('joined').val() === true)",
          "$uid": {
            "$connection": {
              ".write": "auth != null && auth.uid === $uid && root.child('v2/games').child($code).child('control/members').child(auth.uid).child('joined').val() === true",
              ".validate": "newData.hasChildren(['online', 'at'])",
              "online": {
                ".validate": "newData.isBoolean()"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() <= now + 5000 && newData.val() >= now - 60000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
